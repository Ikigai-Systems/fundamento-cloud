#!/usr/bin/env ruby
require "bundler/setup"
require "thor"
require_relative "lib/worktree"

# The main checkout runs the stack as Compose project `e2e-tests` on ports 4000, 6432, ...; each
# git worktree gets its own project and ports from its bin/worktree slot, so several worktrees
# can run E2E at once. `bin/worktree info` shows both.
class DevE2E < Thor
  WEBSITE_CONTAINER = "website"

  default_command :up

  desc "up", "Start the E2E test environment (default command)"
  option :build, type: :boolean, default: true, desc: "Build Docker images before starting"
  option :test, type: :boolean, default: false, desc: "Run Cypress tests after environment is healthy"
  def up
    setup_env!
    load_rails_master_key!
    print_status

    stop_stack

    if options[:build]
      fix_permissions!
      puts "Rebuilding Docker images..."
    else
      puts "Starting Docker Compose services..."
    end

    build_args = options[:build] ? ["--build"] : []
    success = with_terminal_cleanup do
      compose("up", *build_args, "--wait")
    end

    unless success
      abort "\nFailed to start E2E environment."
    end

    puts ""
    puts "E2E environment is ready!"
    puts ""

    warn_build_cache_size! if options[:build]
    unless context.main?
      puts "This worktree's E2E images use up to ~1.3 GB of disk; `bin/worktree teardown` (or `gc`"
      puts "once the worktree is gone) removes them with the stack's containers and volumes."
      puts ""
    end

    if options[:test]
      run_cypress
    else
      print_hints
    end
  end

  desc "down", "Stop E2E containers"
  def down
    setup_env!
    stop_stack
  end

  desc "clean", "Remove all containers, volumes, and local images"
  def clean
    setup_env!
    puts "Removing all E2E containers, volumes, and local images..."
    compose("down", "--volumes", "--remove-orphans", "--rmi", "local")
    puts "Clean complete."
  end

  desc "logs", "Stream docker compose logs (Ctrl-C to exit)"
  def logs
    setup_env!
    exec_compose("logs", "-f")
  end

  desc "console", "Rails console in the website container"
  def console
    setup_env!
    exec_in_container("bin/rails", "console")
  end

  desc "shell", "Bash shell in the website container"
  map "shell" => :open_shell
  def open_shell
    setup_env!
    exec_in_container("bash")
  end

  desc "test", "Run Cypress tests (assumes environment already running)"
  option :device, type: :string, default: "desktop", desc: "Device profile: desktop, phone or tablet (spec/e2e/cypress/support/devices.cjs)"
  def test
    setup_env!
    run_cypress(device: options[:device])
  end

  private

  def context
    @context ||= Worktree::Context.detect
  end

  def project
    context.e2e_project
  end

  # Registering records the stack for `bin/worktree gc` and gives a worktree that never ran
  # bin/worktree setup its slot; the stack needs nothing else from setup, as it builds its own images.
  def ports
    @ports ||= begin
      context.registry.register(context) unless context.main?
      context.e2e_ports
    end
  end

  def setup_env!
    rails = ports.fetch("rails")
    {
      "RAILS_ENV" => "e2e",
      "RAILS_PORT" => rails,
      "RAILS_LOG_LEVEL" => "debug",
      "POSTGRES_PORT" => ports.fetch("postgres"),
      "REDIS_PORT" => ports.fetch("redis"),
      "MINIO_PORT" => ports.fetch("minio"),
      "MINIO_URL" => "http://localhost:#{ports.fetch("minio")}",
      "MINIO_CONSOLE_PORT" => ports.fetch("minio_console"),
      "BLOCKNOTE_PORT" => ports.fetch("blocknote"),
      "HTTP_HOST" => "localhost:#{rails}",
      "CYPRESS_BASE_URL" => ENV["CYPRESS_BASE_URL"] || "http://localhost:#{rails}"
    }.each { |key, value| ENV[key] = value.to_s }
  end

  def load_rails_master_key!
    return if ENV["RAILS_MASTER_KEY"] && !ENV["RAILS_MASTER_KEY"].empty?

    # Try reading from the key file first
    key_file = File.join(Dir.pwd, "config", "credentials", "e2e.key")
    if File.exist?(key_file)
      key = File.read(key_file).strip
      if !key.empty?
        puts "Loading RAILS_MASTER_KEY from config/credentials/e2e.key..."
        puts ""
        ENV["RAILS_MASTER_KEY"] = key
        return
      end
    end

    # Fall back to extracting from SOPS
    sops_file = File.join(Dir.pwd, "config", "secrets", "e2e.sops.yaml")

    unless File.exist?(sops_file)
      abort <<~MSG
        Error: Neither config/credentials/e2e.key nor config/secrets/e2e.sops.yaml found!

        Run bin/setup to extract credential keys from SOPS.
      MSG
    end

    puts "Extracting RAILS_MASTER_KEY from SOPS for e2e environment..."
    puts ""

    configure_sops_age_key!

    key = `sops -d --extract '["rails"]["master_key"]' #{sops_file} 2>/dev/null`.strip

    if $?.success? && !key.empty?
      ENV["RAILS_MASTER_KEY"] = key
    else
      abort <<~MSG
        Error: Failed to extract rails master key from #{sops_file}

        sops needs the age private key. Any one of these works:
          - SOPS_AGE_KEY_FILE pointing at it
          - #{REPO_AGE_KEY_PATH} (run bin/setup to create it)
          - ~/.config/sops/age/keys.txt
      MSG
    end
  end

  # Where this repo keeps its own copy of the age key. bin/setup writes it here, and the CI
  # workflows and Docker builds read it from here — but sops itself only looks in
  # ~/.config/sops/age/keys.txt unless it is told otherwise, so a checkout that followed
  # bin/setup would still fail here without this.
  REPO_AGE_KEY_PATH = File.join("dockerfiles", "sops-age-key.secret")

  def configure_sops_age_key!
    return if ENV["SOPS_AGE_KEY_FILE"].to_s != ""

    repo_key = File.join(Dir.pwd, REPO_AGE_KEY_PATH)
    return unless File.exist?(repo_key)

    puts "Using age key at #{REPO_AGE_KEY_PATH}"
    ENV["SOPS_AGE_KEY_FILE"] = repo_key
  end

  def warn_build_cache_size!
    max_gb = 10

    cache_fields = `docker system df --format '{{.Type}}\t{{.TotalCount}}\t{{.Size}}' 2>/dev/null`
      .each_line
      .find { |line| line.start_with?("Build Cache") }
      &.split("\t")

    return unless cache_fields

    count = cache_fields[1].to_i
    raw_size = cache_fields[2]&.strip
    size_gb = parse_size_to_gb(raw_size)

    return unless size_gb > max_gb

    puts "WARNING: Docker build cache is #{raw_size} (#{count} layers), which may cause build failures."
    puts "  To free space, try these commands (from least to most aggressive):"
    puts ""
    puts "  # Remove only this project's images (triggers a full rebuild next time)"
    puts "  docker compose -p #{project} down --rmi local"
    puts ""
    puts "  # Remove unused build cache layers (keeps layers referenced by existing images)"
    puts "  docker builder prune"
    puts ""
    puts "  # Remove ALL build cache layers including active ones"
    puts "  docker builder prune --all"
    puts ""
  end

  def parse_size_to_gb(size)
    case size
    when /(\d+\.?\d*)\s*GB/i then $1.to_f
    when /(\d+\.?\d*)\s*MB/i then $1.to_f / 1024
    when /(\d+\.?\d*)\s*kB/i then $1.to_f / (1024 * 1024)
    else 0
    end
  end

  def fix_permissions!
    puts "Checking file permissions..."

    extensions = %w[rb erb rake js ts yml]
    pattern = extensions.map { |ext| "-name '*.#{ext}'" }.join(" -o ")
    excludes = "-not -path '*/node_modules/*' -not -path '*/vendor/*' -not -path '*/.git/*'"

    files = `find . -type f \\( #{pattern} \\) #{excludes} ! -perm -044 2>/dev/null`.strip

    return if files.empty?

    file_list = files.split("\n")
    count = file_list.size

    puts "Found #{count} file(s) with restrictive permissions (not world-readable)"
    file_list.first(5).each { |f| puts "  #{f}" }
    puts "   ... and #{count - 5} more" if count > 5
    puts ""
    puts "Fixing permissions to 644 (readable by all, writable by owner)..."

    file_list.each { |f| File.chmod(0644, f) }

    puts "Fixed permissions for #{count} file(s)"
    puts ""
  end

  # The redis and minio images declare volumes (/data, /certs) that docker-compose.yml doesn't
  # map, so Docker gives each container an unnamed one. `down` leaves those behind, two per
  # restart. `rm --volumes` removes them with the containers; the named postgres and minio
  # volumes stay, as with a plain `down`.
  def stop_stack
    compose("rm", "--stop", "--force", "--volumes")
    compose("down")
  end

  def compose(*args)
    cmd = ["docker", "compose", "--ansi", "never", "-p", project, *args]
    system(*cmd)
  end

  def exec_compose(*args)
    Kernel.exec("docker", "compose", "--ansi", "never", "-p", project, *args)
  end

  def exec_in_container(*command)
    container_id = `docker compose -p #{project} ps -q #{WEBSITE_CONTAINER}`.strip

    if container_id.empty?
      abort "Error: #{WEBSITE_CONTAINER} container is not running. Start with: bin/dev-e2e up"
    end

    Kernel.exec("docker", "exec", "-it", container_id, *command)
  end

  def with_terminal_cleanup
    yield
  ensure
    system("tput cnorm 2>/dev/null || printf '\\033[?25h' || true")
    system("stty echo 2>/dev/null || true")
  end

  def run_cypress(device: "desktop")
    system(*virtual_display, "npx", "cypress", "run", "--project", "spec/e2e", "--expose", "device=#{device}")
    exit($?.exitstatus || 1)
  end

  # Without a display Cypress starts its own Xvfb, always on :99, so a second run at the same time
  # fails with "Display :99 is already in use". xvfb-run -a finds a free display instead, starting
  # from one per worktree slot so runs launched together don't race for the same number.
  def virtual_display
    return [] unless RUBY_PLATFORM.include?("linux") && ENV["DISPLAY"].to_s.empty?
    return [] unless system("command -v xvfb-run >/dev/null 2>&1")

    ["xvfb-run", "-a", "-n", (99 + context.slot.to_i).to_s, "-s", "-screen 0 1920x1080x24"]
  end

  def print_status
    puts "Starting E2E test environment (Compose project #{project})..."
    puts "  Rails:         http://localhost:#{ENV['RAILS_PORT']}"
    puts "  MinIO Console: http://localhost:#{ENV['MINIO_CONSOLE_PORT']}"
    puts "  PostgreSQL:    localhost:#{ENV['POSTGRES_PORT']}"
    puts "  Redis:         localhost:#{ENV['REDIS_PORT']}"
    puts ""
  end

  def print_hints
    puts "Quick commands:"
    puts "  Run tests:  bin/dev-e2e test"
    puts "  As a phone: bin/dev-e2e test --device phone"
    puts "  Open UI:    CYPRESS_BASE_URL=#{ENV["CYPRESS_BASE_URL"]} npx cypress open --project spec/e2e"
    puts "  Logs:       bin/dev-e2e logs"
    puts "  Console:    bin/dev-e2e console"
    puts "  Shell:      bin/dev-e2e shell"
    puts "  Stop:       bin/dev-e2e down"
    puts "  Cleanup:    bin/dev-e2e clean"
  end
end

DevE2E.start(ARGV)
