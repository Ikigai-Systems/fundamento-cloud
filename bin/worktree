#!/usr/bin/env ruby
# No bundler/setup: this has to run in a fresh worktree before `bundle install`. Thor comes
# from the shared gem directory, where railties installed it.
require "thor"
require "shellwords"
require_relative "lib/worktree"

class WorktreeCLI < Thor
  DATABASE_YML = "config/database.yml".freeze
  DATABASE_YML_SAMPLE = "config/database.yml.sample".freeze
  CONVERTER_DIR = "micro-services/blocknote-converter".freeze
  TAILWIND_OUTPUT = "app/assets/builds/tailwind.css".freeze

  def self.exit_on_failure?
    true
  end

  default_command :setup

  desc "setup", "Make this checkout ready for bin/rspec and bin/dev (default command, idempotent)"
  long_desc <<~DESC
    Copies the gitignored files listed in .worktreeinclude from the main checkout, writes
    config/database.yml, installs gems and npm packages, builds the blocknote-converter and
    Tailwind. In a linked worktree it also prepares the worktree's own development database
    (created and seeded the first time, migrated after that) and test database, and drops the
    databases of worktrees that no longer exist (see `gc`). Steps whose inputs haven't changed
    are skipped.
  DESC
  option :force, type: :boolean, default: false, desc: "Rerun every step, ignoring stamps"
  def setup
    copy_included_files
    write_database_yml
    bundle_install
    stamped("npm-root", %w[package.json package-lock.json], output: "node_modules") { run!("npm", "ci") }
    stamped("npm-converter", ["#{CONVERTER_DIR}/package.json", "#{CONVERTER_DIR}/package-lock.json"],
            output: "#{CONVERTER_DIR}/node_modules") { run!("npm", "ci", chdir: CONVERTER_DIR) }
    stamped("converter-build", converter_build_inputs, output: "#{CONVERTER_DIR}/build/blocknoteConverter.cjs") do
      run!("npm", "run", "build", chdir: CONVERTER_DIR)
    end
    build_tailwind
    prepare_databases
    collect_garbage(dry_run: false, quiet: true) unless context.main?
    puts ""
    puts "#{context.main? ? "Main checkout" : "Worktree #{context.id}"} is ready."
  end

  desc "config", "Generate config/database.yml from config/database.yml.sample when missing"
  option :force, type: :boolean, default: false, desc: "Overwrite an existing config/database.yml"
  def config
    write_database_yml
  end

  desc "info", "Show this checkout's id and the resources it uses"
  option :format, type: :string, default: "text", enum: %w[text shell], desc: "shell prints KEY=value lines"
  def info
    values = {
      "WORKTREE_ID" => context.id.to_s,
      "WORKTREE_ROOT" => context.root,
      "WORKTREE_MAIN_ROOT" => context.main_root,
      "WORKTREE_DEVELOPMENT_DATABASE" => context.development_database,
      "WORKTREE_TEST_DATABASE" => context.test_database
    }

    if options[:format] == "shell"
      values.each { |key, value| puts "#{key}=#{Shellwords.escape(value)}" }
    else
      puts "Checkout:      #{context.main? ? "main" : "worktree #{context.id}"}"
      puts "Root:          #{context.root}"
      puts "Main checkout: #{context.main_root}" unless context.main?
      puts "Dev database:  #{context.development_database}"
      puts "Test database: #{context.test_database}"
    end
  end

  desc "list", "List this clone's worktrees and the databases recorded for them"
  def list
    registry = context.registry.entries
    existing = with_server { |server| server.databases }
    live = context.live_worktree_paths

    live.each do |path|
      checkout = Worktree::Context.new(root: path, common_dir: context.common_dir)
      databases = registry.dig(path, "databases") || []
      label = checkout.main? ? "main" : checkout.id
      puts "#{label.ljust(32)} #{path}"
      databases.each { |name| puts "  #{name}#{" (missing)" unless existing.include?(name)}" }
    end

    orphans = context.registry.orphans(live)
    orphans.each do |path, entry|
      puts "#{entry["id"].ljust(32)} #{path} (gone; `bin/worktree gc` drops its databases)"
      entry["databases"].each { |name| puts "  #{name}#{" (missing)" unless existing.include?(name)}" }
    end

    recorded = registry.values.flat_map { |entry| entry["databases"] }
    unknown = existing.grep(Worktree::WORKTREE_DATABASE) - recorded
    return if unknown.empty?

    puts ""
    puts "Worktree databases this clone didn't create (left alone by gc):"
    unknown.each { |name| puts "  #{name}" }
  end

  desc "gc", "Drop the databases of this clone's worktrees that no longer exist"
  option :dry_run, type: :boolean, default: false, desc: "Only list what would be removed"
  def gc
    collect_garbage(dry_run: options[:dry_run])
  end

  desc "teardown", "Drop this worktree's databases (run before `git worktree remove`)"
  def teardown
    raise Worktree::Error, "The main checkout has no resources of its own to tear down" if context.main?

    entry = context.registry.entries[context.root]
    databases = entry ? entry["databases"] : context.own_databases.values
    with_server do |server|
      databases.each do |name|
        server.drop(name)
        puts "Dropped #{name}"
      end
    end
    context.registry.remove(context.root)
    database_stamps.each_value(&:delete!)
  end

  private

  def context
    @context ||= Worktree::Context.detect
  end

  def copy_included_files
    copied = Worktree.copy_included_files(context)
    copied.each { |path| puts "Copied #{path} from the main checkout" }
  end

  # A file this command wrote, now or in an earlier version (the plain sample, or only the
  # test database replaced), is safe to regenerate. Anything else was edited by hand and is kept.
  def write_database_yml
    target = path(DATABASE_YML)
    sample = File.read(path(DATABASE_YML_SAMPLE))
    expected = Worktree.database_yml(sample, context.own_databases)

    if File.exist?(target) && !options[:force]
      current = File.read(target)
      return if current == expected

      earlier = [sample, Worktree.database_yml(sample, context.own_databases.slice("test"))]
      unless earlier.include?(current)
        puts "Kept existing #{DATABASE_YML}; it differs from what bin/worktree generates (--force to regenerate)"
        return
      end
    end

    File.write(target, expected)
    puts "Wrote #{DATABASE_YML} from #{DATABASE_YML_SAMPLE}"
  end

  # `bundle check` is the source of truth here rather than a stamp: it also catches gems that
  # are pinned to a git ref nobody has checked out yet.
  def bundle_install
    return if system("bundle", "check", out: File::NULL, err: File::NULL, chdir: context.root)

    run!("bundle", "install")
  end

  def converter_build_inputs
    %W[#{CONVERTER_DIR}/package-lock.json #{CONVERTER_DIR}/package.json #{CONVERTER_DIR}/src/**/*
       vendor/javascript/rowstack/**/*]
  end

  # The CSS only has to exist for request and view specs; bin/dev keeps it current while
  # running, so a stale build is harmless and not worth a stamp over every template.
  def build_tailwind
    return if File.exist?(path(TAILWIND_OUTPUT)) && !options[:force]

    run!("bin/rails", "tailwindcss:build")
  end

  # Linked worktrees get their own databases: `bin/rspec` in two checkouts at once doesn't
  # truncate each other's tables, and a worktree's dev server runs its branch's migrations and
  # background jobs against its own data. They are registered before they are created, so a
  # setup that fails halfway still leaves them for `gc` to find.
  #
  # db:prepare creates, loads the schema and seeds a missing development database, and only
  # migrates an existing one. db:test:prepare reloads the test schema.
  def prepare_databases
    return if context.main?

    context.registry.register(context)
    commands = {
      context.test_database => %w[bin/rails db:test:prepare],
      context.development_database => %w[bin/rails db:prepare]
    }
    database_stamps.each do |name, stamp|
      exists = with_server { |server| server.exists?(name) }
      next if stamp.current? && exists && !options[:force]

      run!(*commands.fetch(name))
      stamp.write!
    end
  end

  def database_stamps
    {
      context.test_database => Worktree::Stamp.new(context.root, "test-database", ["db/schema.rb", DATABASE_YML]),
      context.development_database => Worktree::Stamp.new(context.root, "development-database",
                                                          ["db/schema.rb", "db/migrate/**/*", DATABASE_YML])
    }
  end

  def collect_garbage(dry_run:, quiet: false)
    orphans = context.registry.orphans(context.live_worktree_paths)
    if orphans.empty?
      puts "Nothing to clean up" unless quiet
      return
    end

    with_server do |server|
      orphans.each do |path, entry|
        entry["databases"].each do |name|
          puts "#{dry_run ? "Would drop" : "Dropped"} #{name} (#{path} is gone)"
          server.drop(name) unless dry_run
        end
        context.registry.remove(path) unless dry_run
      end
    end
  end

  def with_server
    server = Worktree::Server.for(context.root)
    yield server
  ensure
    server&.close
  end

  def stamped(name, inputs, output:)
    stamp = Worktree::Stamp.new(context.root, name, inputs)
    return if stamp.current? && File.exist?(path(output)) && !options[:force]

    yield
    stamp.write!
  end

  def run!(*command, chdir: ".")
    dir = File.join(context.root, chdir)
    puts "== #{command.join(" ")}#{" (in #{chdir})" unless chdir == "."}"
    return if system(*command, chdir: dir)

    abort "Failed: #{command.join(" ")}"
  end

  def path(relative)
    File.join(context.root, relative)
  end
end

begin
  WorktreeCLI.start(ARGV)
rescue Worktree::Error => e
  abort e.message
end
