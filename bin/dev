#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Infrastructure (Postgres, Redis, MinIO) is shared by every checkout of this clone. Compose
# names a project after its directory, so from a linked worktree it would start a second
# stack on the same ports; always use the main checkout's project instead.
MAIN_ROOT=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
compose() {
  docker compose --project-directory "$MAIN_ROOT" -f "$MAIN_ROOT/docker-compose.yml" "$@"
}

# Extract app services from Procfile.dev (first word on each line)
DEVELOPMENT_SERVICES=$(awk -F: '{print $1}' Procfile.dev | tr '\n' ' ')

# Get all docker compose services
ALL_DOCKER_SERVICES=$(compose config --services)

# Filter out app services to get infrastructure services
DOCKER_SERVICES_TO_RUN=""
for service in $ALL_DOCKER_SERVICES; do
  # Check if this service is NOT in DEVELOPMENT_SERVICES
  if ! echo "$DEVELOPMENT_SERVICES" | grep -wq "$service"; then
    DOCKER_SERVICES_TO_RUN="$DOCKER_SERVICES_TO_RUN $service"
  fi
done

# Check if any infrastructure services need to be started
SERVICES_NEEDED=false
for service in $DOCKER_SERVICES_TO_RUN; do
  if ! compose ps --status running --format json | grep -q "\"Service\":\"$service\""; then
    SERVICES_NEEDED=true
    break
  fi
done

# Start infrastructure services if needed
if [ "$SERVICES_NEEDED" = true ]; then
  echo "Starting infrastructure services:$DOCKER_SERVICES_TO_RUN"
  compose up -d $DOCKER_SERVICES_TO_RUN

  echo "Waiting for services to be healthy..."
  compose up --wait $DOCKER_SERVICES_TO_RUN
  echo "Infrastructure services are ready!"
else
  echo "Infrastructure services already running, skipping docker compose..."
fi

# A linked worktree gets its own databases, ports and Redis key prefix from bin/worktree, which
# writes them to .env.development.local (fast when nothing changed).
if [ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
  bin/worktree setup || exit 1
fi

# Foreman applies env files in order, so the worktree's file overrides .env (e.g. HTTP_HOST).
ENV_FILES=""
for file in .env .env.development.local; do
  if [ -f "$file" ]; then
    ENV_FILES="${ENV_FILES:+$ENV_FILES,}$file"
  fi
done

# Default to port 3000 if not specified (a worktree's PORT comes from its env file)
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev ${ENV_FILES:+-e "$ENV_FILES"} "$@"