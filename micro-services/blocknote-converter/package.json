{
  "name": "blocknote-converter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npx esbuild --bundle --external:canvas --external:jsdom --external:happy-dom --loader:.css=empty --loader:.tsx=tsx --jsx=automatic --platform=node src/index.ts --outfile=build/blocknoteConverter.cjs --format=cjs --alias:rowstack=../../vendor/javascript/rowstack/main.js",
    "build:watch": "npm run build -- --watch",
    "server": "nodemon -w build build/blocknoteConverter.cjs server",
    "server:watch": "concurrently -k -n build,server -c yellow.bold,cyan.bold \"npm run build:watch\" \"npm run server\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@eslint/js": "^10.0.1",
    "@fastify/formbody": "^9.0.0",
    "@fastify/request-context": "^7.0.0",
    "@sentry/node": "^10.70.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/ui": "^4.1.11",
    "commander": "^15.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@blocknote/server-util": "^0.54.0",
    "@types/node": "^26.2.0",
    "fastify": "^5.12.1",
    "hast-util-to-html": "^9.0.5",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32"
  },
  "packageManager": "npm@11.6.2"
}
