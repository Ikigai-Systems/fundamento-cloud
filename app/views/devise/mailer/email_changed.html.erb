<h1>Your email address was changed</h1>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Your email address is being changed to <strong><%= @resource.unconfirmed_email %></strong>.</p>
<% else %>
  <p>The email address for your account is now <strong><%= @resource.email %></strong>.</p>
<% end %>

<p class="muted">If you didn't do this, contact us by replying to this email.</p>
