<h1>Log in to Fundamento</h1>

<p>Use the button below to log in as <strong><%= @resource.email %></strong>.</p>

<%= email_button "Log in to my account", magic_link_url(@resource, @scope_name => {email: @resource.email, token: @token, remember_me: @remember_me}) %>

<p class="muted">The link expires in <%= Devise.passwordless_login_within.inspect %>. If you didn't ask to log in, you can ignore this email.</p>
