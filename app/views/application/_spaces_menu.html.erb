<div
  data-controller="dropdown"
  data-action="click@window->dropdown#hide touchstart@window->dropdown#hide keydown.up->dropdown#previousItem keydown.down->dropdown#nextItem keydown.esc->dropdown#hide"
  class="relative inline-block text-left"
>
  <button
    id="spaces-dropdown"
    data-action="dropdown#toggle:stop"
    class="inline-flex w-full items-center justify-center gap-x-1.5 whitespace-nowrap rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:!bg-gray-800 dark:ring-gray-500 dark:text-gray-400 dark:hover:text-white dark:hover:!bg-gray-700"
    aria-expanded="true"
    aria-haspopup="true">
    <span class="inline-flex items-center gap-1">
      <%= render ObjectIcon.new(type: Space) %>
      Spaces
    </span>

    <span class="icon-[tabler--chevron-down] -mr-1 size-5 text-gray-400" aria-hidden="true"></span>
  </button>

  <div
    data-dropdown-target="menu"
    class="hidden absolute top-5 left-0 z-10 mt-5 flex w-screen max-w-max"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="spaces-dropdown"
    tabindex="-1"
  >
    <div class="dropdown-container w-56">
      <% if current_organization.present? %>
        <% policy_scope(current_organization.spaces.without_archived).order(:name).filter(&:persisted?).each do |space| %>
          <%= link_to space_path(space),
            data: {"dropdown-target" => "menuItem"},
            class: "truncate",
            role: "menuitem",
            tabindex: "-1" do
          %>
            <%= render ObjectIcon.new(object: space) %>
            <%= space.title %>
          <% end %>
        <% end %>
      <% end %>

      <% if policy(Space).create? %>
        <hr class="border-t">

        <%= link_to "Create space", new_space_path, data: {"dropdown-target" => "menuItem"}, role: "menuitem", tabindex: "-1" %>
      <% end %>
    </div>
  </div>
</div>
