<%= turbo_frame_tag "modal" do %>
  <%= form_for(@api_token, url: api_tokens_path,
    html: { class: "default-form" },
    data: { turbo: false, controller: "prevent-double-submit" }) do |f|
  %>
    <% content_for :modal_icon do %>
      <span class="modal-icon icon-[tabler--alert-triangle]" aria-hidden="true"></span>
    <% end %>

    <% content_for :modal_title do %>
      Save API Token
    <% end %>

    <% content_for :modal_main_content do %>
      <p class="mt-2">
        Save your API Token, it's the only place you will be able to see it.
      </p>

      <div class="form-field">
        <%= f.label :encrypted_token, "API Token" %>
        <div class="flex flex-row items-center gap-2" data-controller="clipboard" data-clipboard-success-content-value="Copied!">
          <%= f.text_field :encrypted_token, autofocus: true, readonly: true, class: "form-input mt-0 h-10",
                data: { clipboard_target: "source" } %>
          <button type="button" aria-label="Copy the token" title="Copy to clipboard" class="secondary-button px-2 shadow-md h-10"
                  data-clipboard-target="button" data-action="clipboard#copy">
            <span class="icon-[tabler--clipboard] size-6"></span>
          </button>
        </div>

      </div>
    <% end %>

    <% content_for :modal_buttons do %>
      <button type="button" data-action="modal#close" class="modal-submit-button form-submit">Close</button>
    <% end %>

    <%= render template: "application/components/modal_content" %>
  <% end %>
<% end %>
