<%= turbo_stream_from [current_organization, current_user, :api_tokens_list] %>

<% content_for :focused_header do %>
  API Tokens
<% end %>

<% content_for :focused_header_buttons do %>
  <div class="mt-4 flex md:ml-4 md:mt-0 gap-2">
    <%= link_to "Connected Apps",
      oauth_authorized_applications_path,
      class: "secondary-button"
    %>
    <% if policy(ApiToken).create? %>
      <%= link_to "Create",
        new_user_api_token_path(current_user),
        class: "secondary-button",
        data: { turbo_frame: "modal", action: "modal#open" }
      %>
    <% end %>
  </div>
<% end %>

<% content_for :focused_content do %>
  <div class="table-legend">
    <div class="table-legend-description">
      <p>A list of all API tokens you created for this organization.</p>
      <p>
        An API token lets a program act as you in <strong><%= current_organization.name %></strong>, with your
        permissions. Send it as a <code>Bearer</code> token in the <code>Authorization</code> header to:
      </p>
      <ul class="list-disc pl-5">
        <li>call the REST API under <code>/api/v1</code>: spaces, documents, tables, formulas, imports, automations and packs;</li>
        <li>sign in the <code>funcli</code> command-line client;</li>
        <li>connect an MCP client that sends a header instead of signing in.</li>
      </ul>
      <p>
        A token works for this organization only. To connect an AI assistant that can sign in on its own, use
        <%= link_to "AI Assistants", ai_assistants_path, class: "underline" %> instead, which needs no token.
      </p>
    </div>
  </div>

  <%= render partial: "api_tokens/api_tokens_table" %>
<% end %>

<%= render "focused_section" %>