<div
  data-controller="dropdown"
  data-action="click@window->dropdown#hide touchstart@window->dropdown#hide keydown.up->dropdown#previousItem keydown.down->dropdown#nextItem keydown.esc->dropdown#hide"
  class="relative inline-block w-full"
>
  <div class="flex items-center gap-3">
    <button
      id="spaces-dropdown"
      data-action="dropdown#toggle:stop"
      class="secondary-button w-full justify-between py-1.5 truncate"
      aria-expanded="true"
      aria-haspopup="true">

      <span class="truncate">
        <%= render ObjectIcon.new(object: @space) %>
        <%= @space.title %>
      </span>

      <span class="icon-[tabler--chevron-down] -mr-1 h-5 w-5 text-gray-400 shrink-0" aria-hidden="true"></span>
    </button>

    <% if policy(@space).update? %>
      <%= link_to edit_space_path(@space), data: { turbo: false }, class: "secondary-button" do %>
        <i class="icon-[tabler--settings]"></i>
      <% end %>
    <% end %>
  </div>

  <%# z-30, not z-20: the sidebar tab bar below is relative z-20 and comes later in the DOM,
      so at the same level it would paint over this menu. %>
  <div
    data-dropdown-target="menu"
    class="hidden absolute top-5 left-0 z-30 mt-5 flex w-screen max-w-max"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="spaces-dropdown"
    tabindex="-1"
  >
    <div class="dropdown-container w-56">
      <% if current_organization.present? %>
        <% policy_scope(current_organization.spaces.without_archived).order(:name).filter(&:persisted?).each do |space| %>
          <%= link_to space_path(space),
            data: { dropdown_target: "menuItem", turbo_frame: "_top" },
            class: "truncate",
            role: "menuitem",
            tabindex: "-1" do
          %>
            <%= render ObjectIcon.new(object: space) %>
            <%= space.title %>
          <% end %>
        <% end %>
      <% end %>

      <% if policy(Space).create? %>
        <hr class="border-t">

        <%= link_to "Create space", new_space_path, data: { dropdown_target: "menuItem", turbo: false }, role: "menuitem", tabindex: "-1" %>
      <% end %>
    </div>
  </div>
</div>
