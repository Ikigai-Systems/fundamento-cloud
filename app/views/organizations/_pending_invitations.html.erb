<% invitations = organization.listed_invitations.to_a %>

<% if invitations.any? %>
  <div class="table-legend mt-8" id="pending-invitations">
    <div class="table-legend-description">
      <h2>Pending invitations</h2>
      <p>People invited to join who haven't accepted yet.</p>
    </div>
  </div>

  <table class="table-list">
    <thead>
    <tr>
      <th scope="col">Email</th>
      <th scope="col">Invited by</th>
      <th scope="col">Status</th>
      <th scope="col">Action</th>
    </tr>
    </thead>
    <tbody>
    <% invitations.each do |invitation| %>
      <% sent_at = invitation.invitation_sent_at || invitation.invitation_created_at || invitation.created_at %>
      <% expires_at = sent_at + Devise.invite_for %>
      <tr id="<%= dom_id(invitation) %>">
        <th scope="row"><%= invitation.email %></th>
        <td><%= invitation.invited_by&.display_name %></td>
        <td>
          <% if expires_at.past? %>
            Expired <%= time_ago_in_words(expires_at) %> ago
          <% else %>
            Sent <%= time_ago_in_words(sent_at) %> ago, expires in <%= time_ago_in_words(expires_at) %>
          <% end %>
        </td>
        <td>
          <%= button_to "Resend", resend_organization_invitation_path(organization, invitation), class: "link-button", method: :post %>
          <%= button_to "Revoke", organization_invitation_path(organization, invitation),
            form: { data: { turbo_confirm: "Revoke the invitation for #{invitation.email}? Its link will stop working." } },
            class: "link-button", method: :delete %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
