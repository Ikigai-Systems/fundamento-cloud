<section class="form-section">
  <h2 class="form-header">Edit organization</h2>

  <%= form_for(@organization,
    html: { class: "default-form" },
    data: { turbo: false, controller: "prevent-double-submit" }) do |f|
  %>
    <%= render "devise/shared/error_messages", resource: @organization %>

    <div class="form-field">
      <%= f.label :name %>
      <%= f.text_field :name, autofocus: true, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :time_zone %>
      <%= f.select :time_zone, Organization.time_zone_choices, {}, class: "form-input" %>
      <p class="form-hint">Formulas such as Today() and Now() use this time zone for everyone in the organization.</p>
    </div>

    <div class="form-footer">
      <%= link_to "Cancel", organization_path(@organization), class: "secondary-button" %>
      <%= f.submit "Save", class: "form-submit" %>
    </div>
  <% end %>
</section>