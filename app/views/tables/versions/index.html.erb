<% content_for :content_menu do %>
  <%= link_to "View table",
    table_path(@table),
    class: "link-button before:icon-[heroicons--arrow-uturn-left-16-solid] before:mr-1" %>
<% end %>

<article class="flex flex-col">
  <div class="px-[3.4rem]">
    <h1 class="mt-1 text-4xl text-slate-800 flex items-center gap-2">
      History - <%= render ObjectIcon.new(object: @table) %><%= @table.title %>
    </h1>

    <div class="mt-4">
      <%# The empty state carries its own heading, so this one would just stack on top. %>
      <% if @versions.any? %>
        <div class="sm:flex sm:items-center">
          <div class="sm:flex-auto">
            <h1 class="text-base font-semibold text-xl leading-6 text-slate-900">Versions</h1>
          </div>
        </div>
      <% end %>
      <div class="mt-4 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <% if @versions.empty? %>
              <div class="py-4 max-w-2xl" data-testid="no-versions-notice">
                <h2 class="text-base font-semibold text-slate-900">No versions yet</h2>

                <p class="mt-2 text-sm text-slate-600">
                  A version is saved automatically a few minutes after this table changes.
                  Editing a cell, adding or deleting a row, and adding, renaming, retyping
                  or removing a column all count &mdash; a burst of edits is saved as one
                  version rather than one per keystroke.
                </p>

                <p class="mt-2 text-sm text-slate-600">
                  Once the first version is saved it appears here, and you can view the
                  table as it was and restore it. Nothing is overwritten: restoring saves
                  the current state as its own version first.
                </p>
              </div>
            <% else %>
              <table class="min-w-full divide-y divide-gray-300">
                <thead>
                <tr>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-slate-900 sm:pl-0">Version</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Date</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Changes</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Created by</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Contributors</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Actions</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <% @versions.each do |version| %>
                    <tr>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-0"><%= version.sequential_id %></td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500"><%= version.created_at.strftime("%F") %></td>
                      <td class="px-3 py-4 text-sm text-slate-500" data-testid="version-summary"><%= table_version_summary(version) %></td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                        <% if version.created_by.blank? %>
                          <%# Baseline, backfilled and system-made versions have no author. %>
                          <div title="Automatic" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center font-bold">
                            ?
                          </div>
                        <% else %>
                          <%= render UserAvatar.new(user: version.created_by, organization: current_organization) %>
                        <% end %>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500" data-testid="version-contributors">
                        <% version_contributors = version.contributors %>
                        <% if version_contributors.any? %>
                          <%= render UserAvatarsGroup.new(users: version_contributors, organization: current_organization, variant: "xs") %>
                        <% end %>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                        <%= link_to "Show", table_version_path(@table, version), class: "link-button" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
