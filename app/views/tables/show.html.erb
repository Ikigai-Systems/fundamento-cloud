<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% content_for :content_title do %>
  <%= react_component "EditableContentTitle", {
    content_type: "table",
    table: @table.to_react_props,
    editable: policy(@table).update?,
  } %>
<% end %>

<% content_for :content_menu do %>
  <% if (favorite = pundit_user.organization_membership.favorites.find_by(object: @table)) %>
    <%= render partial: "favorites/destroy_favorite", locals: { object: @table, favorite: favorite } %>
  <% else %>
    <%= render partial: "favorites/create_favorite", locals: { object: @table } %>
  <% end %>

  <% has_permission_to_edit = policy(@table).update? %>

  <div data-controller="tooltip" class="relative">
    <%= button_to edit_table_path(@table),
      method: :get,
      id: dom_id(@table, :edit),
      disabled: !has_permission_to_edit,
      class: "document-toolbar-button edit-table-button",
      form: { data: { action: "pointerenter->tooltip#show pointerleave->tooltip#hide focusin->tooltip#show focusout->tooltip#hide" } },
      aria: { label: "Edit table" } do
    %>
      <i class="icon-[tabler--pencil]"></i>
    <% end %>

    <template data-tooltip-target="content">
      <div data-tooltip-target="card" class="popover-tooltip-card m-1">
        <p>
          <% if has_permission_to_edit %>
            Edit <code>E</code>
          <% else %>
            You lack permission to edit this table
          <% end %>
        </p>
      </div>
    </template>
  </div>

  <% if has_permission_to_edit %>
    <% add_palette_command id: "edit_table",
      title: "Edit table",
      section: "Actions",
      hotkey: "e",
      handler: "document.querySelector('##{ dom_id(@table, :edit) }').click()",
      icon: "pencil"
    %>
  <% end %>

  <%= render partial: "content/document_menu", locals: { space: @space, content: @table } %>
<% end %>

<% content_for :content_menu_end do %>
  <%= render SidebarDrawerButton.new(side: :right) %>
<% end %>

<article class="flex flex-col">
  <%= react_component "ViewTablePanel", {
    table: @table,
    space: @space.to_react_props
  }, {
    data: TableDataBlueprint.render(@table.data_to_json(
      evaluate_formulas: true,
      evaluate_as: current_organization_membership,
    ))
  } %>
</article>

<%= turbo_frame_tag @table, :reactions, src: reactions_path(object_gid: @table.to_gid_param), loading: "lazy" %>

<%= render partial: "comments/frames", locals: { resource: @table } %>
