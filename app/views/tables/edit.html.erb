<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% content_for :content_title do %>
  <%= react_component "EditableContentTitle", {
    content_type: "table",
    table: @table.to_react_props,
    editable: true,
  } %>
<% end %>

<% content_for :content_menu do %>
  <%= link_to table_path(@table),
    class: "document-toolbar-button",
    aria: { label: "Stop editing" },
    title: "Stop editing" do %>
    <i class="icon-[tabler--arrow-back-up]"></i>
  <% end %>

  <%= render partial: "content/document_menu", locals: { space: @space, content: @table } %>
<% end %>

<% content_for :content_menu_end do %>
  <%= render SidebarDrawerButton.new(side: :right) %>
<% end %>

<article class="flex flex-col">
  <%= react_component "EditTablePanel", {
    table: @table,
    space: @table.space.to_react_props
  }, {
    data: TableDataBlueprint.render(@table.data_to_json(
      evaluate_formulas: true,
      evaluate_as: current_organization_membership,
    ))
  } %>

  <p class="mx-auto p-3 text-sm text-center">
    <i class="icon-[tabler--info-circle]"></i>
    Changes are saved automatically
  </p>
</article>
