<%= form_for(organization_membership, method: :patch, data: { controller: "prevent-double-submit" }) do |f| %>
  <% content_for :modal_icon do %>
    <span class="modal-icon icon-[tabler--alert-triangle]" aria-hidden="true"></span>
  <% end %>

  <% content_for :modal_title do %>
    Change password
  <% end %>

  <% content_for :modal_main_content do %>
    <p class="modal-subtitle">
      You're changing the password for <b><%= organization_membership.display_name %></b>
    </p>

    <%= render "devise/shared/error_messages", resource: organization_membership %>

    <%= f.fields_for :user do |user_form| %>
      <%= user_form.hidden_field :id, value: organization_membership.user_id %>

      <div class="form-field">
        <%= user_form.label :password %>
        <%= user_form.password_field :password, class: "form-input" %>
      </div>

      <div class="form-field">
        <%= user_form.label :password_confirmation %>
        <%= user_form.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>
    <% end %>
  <% end %>

  <% content_for :modal_buttons do %>
    <button type="submit" class="modal-submit-button danger-button">Save</button>
    <button type="button" data-action="modal#close" class="modal-cancel-button secondary-button">Cancel</button>
  <% end %>

  <%= render template: "application/components/modal_content" %>
<% end %>
