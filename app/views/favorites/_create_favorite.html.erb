<%= button_to favorites_path,
  form:  { id: dom_id(object, "favorite") },
  method: :post,
  params: { favorite: { object_type: object.class, object_id: object.id } },
  class: "document-toolbar-button",
  aria: { label: "Star" },
  title: "Star" do
%>
  <i class="fa-sharp fa-regular fa-star fa-fw"></i>
<% end %>