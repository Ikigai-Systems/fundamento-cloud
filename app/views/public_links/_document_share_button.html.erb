<button
  id="document_share_button"
  data-action="dropdown#toggle:stop"
  class="document-toolbar-button"
  aria-expanded="true"
  aria-haspopup="true"
>
  <% if public_link_exists %>
    <i class="icon-[tabler--world]"></i>
  <% else %>
    <i class="icon-[tabler--upload]"></i>
  <% end %>
</button>