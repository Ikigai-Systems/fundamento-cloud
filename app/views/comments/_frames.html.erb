<div class="m-3 flex flex-col gap-3">
  <%= turbo_frame_tag "object_comments", src: comments_path(object_gid: resource.to_gid_param), loading: "lazy" %>

  <% if policy(resource.comments.new).create? %>
    <div>
      <style>
        turbo-frame#new_object_comment:not(:empty) + turbo-frame#add_object_comment {
          display: none;
        }
      </style>

      <%= turbo_frame_tag "new_object_comment" %>

      <%= turbo_frame_tag "add_object_comment" do %>
        <%= link_to(
              new_comment_path(object_gid: resource.to_gid_param),
              data: { turbo_frame: "new_object_comment" },
              class: "secondary-button gap-1"
            ) do
        %>
          <i class="icon-[tabler--message]"></i>
          Comment
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Comments on blocks that have been removed from the document stay, out of the way. %>
  <% if resource.is_a?(Document) && resource.comments.anchored.exists? %>
    <% orphaned_count = resource.orphaned_comments.count %>

    <% if orphaned_count > 0 %>
      <details class="rounded-xl border" data-orphaned-comments>
        <summary class="cursor-pointer px-3 py-2 text-sm font-medium">
          Comments on removed blocks (<%= orphaned_count %>)
        </summary>

        <div class="p-3">
          <%= turbo_frame_tag ObjectComment::ORPHANED_FRAME_ID,
                src: comments_path(object_gid: resource.to_gid_param, orphaned: 1),
                loading: "lazy" %>
        </div>
      </details>
    <% end %>
  <% end %>
</div>
