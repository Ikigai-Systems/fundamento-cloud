# SQLite. Versions 3.8.0 and up are supported.
#   gem install sqlite3
#
#   Ensure the SQLite 3 gem is defined in your Gemfile
#   gem "sqlite3"
#
default: &default
  adapter: postgresql
  encoding: unicode
  url: <%= ENV.fetch("DATABASE_URL", "postgres://postgres:password@localhost") %>
  # Headroom over the thread count on purpose: Good Job needs a connection per worker
  # thread plus a few of its own (the LISTEN notifier and the shared executor). Sized to
  # the threads alone, the notifier starves with ConnectionTimeoutError.
  max_connections: <%= ENV.fetch("RAILS_MAX_CONNECTIONS") { ENV.fetch("RAILS_MAX_THREADS") { 5 }.to_i + 3 } %>

development:
  <<: *default
  database: development

# Warning: The database defined as "test" will be erased and
# re-generated from your development database when you run "rake".
# Do not set this db to the same as development or production.
test:
  <<: *default
  database: test

production:
  <<: *default
  adapter: postgresql
  encoding: unicode
  url: <%= ENV.fetch("DATABASE_URL", "postgres://postgres:password@db/postgres") %>
  database: postgres
